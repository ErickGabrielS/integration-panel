{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "Sqlite"
  },
  "ConnectionStrings": {
    "Panel": "Data Source=panel.db"
  },
  "Jwt": {
    "Issuer": "integration-panel",
    "Audience": "integration-panel",
    "Key": "",
    "ExpiresMinutes": 120
  },
  "Ai": {
    "Provider": "Simulator",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini",
    "InputPricePerMillion": 0.15,
    "OutputPricePerMillion": 0.60,
    "DailyCallLimit": 100,
    "DailyCostLimitUsd": 1.00,
    "MaxToolRounds": 4
  },
  "Demo": {
    "Seed": false
  }
}
